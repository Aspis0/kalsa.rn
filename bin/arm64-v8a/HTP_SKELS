libggml-htp-v73.so=9a3b17d7bb510c0e0f5819fea98b71b7e50070badf893e28ac1dd34889a3d015
libggml-htp-v75.so=21d5faa3ae77cacde5a13cbd66e2f6b9ae0554234e4f834f86602e60c43b03b3
libggml-htp-v79.so=225ce49a0b52a8256d7abdc96337cce44aa30afb4ab35a79275735d16c7a954b
