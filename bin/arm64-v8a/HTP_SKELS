libggml-htp-v73.so=2369e1f76fbd234b888b469f4b0e150067cb38620c94e2589ecd49380116b4b3
libggml-htp-v75.so=ecf14ed106749af8634112f7453ec65d67089089819a568b5a2b3bf592727331
libggml-htp-v79.so=daa166a66517eb4e4faf1fde592238fc355a438128e65a1e47fbc112796146f6
